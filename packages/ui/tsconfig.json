{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "composite": true,
        "lib": [
            "DOM",
            "ESNext"
        ],
        "types": [
            "react",
            "react-dom",
        ],
        "outDir": "dist",
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.svg",
    ],
    "exclude": [
        "node_modules"
    ]
}